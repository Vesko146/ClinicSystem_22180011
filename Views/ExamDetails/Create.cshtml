@model ClinicSystem_22180011.Models.ExamDetail

@{
    ViewData["Title"] = "Резултати от преглед";
}

<h2>Медицински картон на прегледа</h2>
<h4>@ViewBag.AppointmentInfo</h4>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <input type="hidden" asp-for="AppointId" />
            <div class="d-flex justify-content-between align-items-center mb-4 p-3 rounded-4 shadow-sm bg-white border">
                <div>
                    <span class="text-muted small d-block fw-bold text-uppercase">Финансов модел на прегледа</span>
                    <h4 class="fw-bold m-0 text-dark">Картон на прегледа</h4>
                </div>
                <div>
                    @if (ViewBag.PaymentType == "НЗОК")
                    {
                        <div class="badge bg-success-subtle text-success border border-success-subtle px-4 py-3 rounded-3 d-flex align-items-center gap-2">
                            <i class="bi bi-shield-plus fs-4"></i>
                            <div class="text-start">
                                <strong class="d-block fs-6 lh-1">НАПРАВЛЕНИЕ ПО НЗОК</strong>
                                <small class="text-muted" style="font-size: 0.7rem;">Потребителска такса: 2.90 euro</small>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-4 py-3 rounded-3 d-flex align-items-center gap-2">
                            <i class="bi bi-cash-coin fs-4"></i>
                            <div class="text-start">
                                <strong class="d-block fs-6 lh-1">ПЛАТЕН ПРИЕМ</strong>
                                <small class="text-muted" style="font-size: 0.7rem;">Всички консултации се заплащат</small>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="form-group mb-3">
                <label class="control-label">Диагноза</label>
                <textarea asp-for="Diagnosis" class="form-control" rows="3" placeholder="Пример: Катаракта на дясно око..."></textarea>
            </div>
            <div class="form-group mb-3">
                <label class="control-label">Предписание (Рецепта)</label>
                <textarea asp-for="Prescription" class="form-control" rows="3" placeholder="Пример: Очни капки 2х1..."></textarea>
            </div>
            <div class="form-group">
                <button type="submit" class="btn btn-primary">Запиши в картона</button>
                <a asp-controller="Appointments" asp-action="Index" class="btn btn-secondary">Назад</a>
            </div>
        </form>
    </div>
</div>