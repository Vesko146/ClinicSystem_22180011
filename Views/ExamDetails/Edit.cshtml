@model ClinicSystem_22180011.Models.ExamDetail

@{
    ViewData["Title"] = "Редактиране на медицински картон";
}

<h2 class="text-center my-4 text-primary">Редактиране на медицински данни</h2>
<h5 class="text-center text-muted mb-4">@ViewBag.AppointmentInfo</h5>

<div class="row justify-content-center">
    <div class="col-md-6 shadow p-4 rounded bg-white border">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="DetailId" />
            <input type="hidden" asp-for="AppointId" />
            <input type="hidden" asp-for="PaymentType" />
            <input type="hidden" asp-for="LastModified22180011" />

            <div class="mb-3">
                <label class="form-label font-weight-bold fw-bold">Тип финансиране</label>
                <input class="form-control" type="text" value="@ViewBag.PaymentType" disabled />
            </div>

            <div class="mb-3">
                <label asp-for="Diagnosis" class="form-label font-weight-bold fw-bold">Диагноза</label>
                <textarea asp-for="Diagnosis" class="form-control" rows="3" required placeholder="Въведете диагноза..."></textarea>
                <span asp-validation-for="Diagnosis" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Prescription" class="form-label font-weight-bold fw-bold">Предписано лечение / Рецепта</label>
                <textarea asp-for="Prescription" class="form-control" rows="4" required placeholder="Въведете лекарства и инструкции..."></textarea>
                <span asp-validation-for="Prescription" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a asp-controller="Appointments" asp-action="Index" class="btn btn-outline-secondary px-4">
                    <i class="bi bi-arrow-left"></i> Назад
                </a>
                <button type="submit" class="btn btn-warning text-dark px-4 fw-bold">
                    <i class="bi bi-save"></i> Запази промените
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}