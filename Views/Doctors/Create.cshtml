@model ClinicSystem_22180011.Models.Doctor

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Doctor</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="FullName" class="control-label">Име и Фамилия</label>
                <input asp-for="FullName" class="form-control" required />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label class="control-label">Имейл (Потребителско име)</label>
                <input name="Email" type="email" class="form-control" required />
            </div>

            <div class="form-group">
                <label class="control-label">Парола</label>
                <input name="Password" type="password" class="form-control" required />
                <small class="form-text text-muted">Минимум 6 символа, цифра и специален знак.</small>
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Работен график</label>
                <select asp-for="ScheduleGroup" class="form-control">
                    <option value="Alpha">Schedule Alpha (Пон, Ср, Пт - Сутрин)</option>
                    <option value="Beta">Schedule Beta (Вт, Чт, Пт - Следобед)</option>
                </select>
            </div>
            <div class="form-group mb-3">
                <label class="control-label fw-bold">Специалност (Табелка)</label>
                <input name="Specialty" class="form-control" placeholder="напр. Детски офталмолог" />
            </div>

            <div class="form-group mb-3">
                <label class="control-label fw-bold">Биография и информация</label>
                <textarea name="Biography" class="form-control" rows="4" placeholder="Въведете опита на лекаря..."></textarea>
            </div>

            <br />
            <div class="form-group">
                <input type="submit" value="Създай Лекар и Профил" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
