@model ClinicSystem_22180011.Models.Doctor

<div class="container mt-5">
    <div class="card shadow border-0">
        <div class="card-header bg-primary text-white p-3">
            <h4 class="mb-0"><i class="fas fa-user-edit"></i> Редактиране на профил: @Model.FullName</h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="DoctorId" />

                <input type="hidden" asp-for="LastModified22180011" />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Име на лекаря</label>
                        <input asp-for="FullName" class="form-control shadow-sm" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Специалност (Табелка)</label>
                        <input asp-for="Specialty" class="form-control shadow-sm" placeholder="напр. Хирург - ретина" />
                        <span asp-validation-for="Specialty" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">График / Работни дни</label>
                    <select asp-for="ScheduleGroup" class="form-select shadow-sm">
                        <option value="Понеделник - Сряда">Понеделник, Сряда и Петък сутрин.</option>
                        <option value="Четвъртък - Петък">Вторник, Четвъртък и Петък следобед.</option>
                    </select>
                    <span asp-validation-for="ScheduleGroup" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">Биография и квалификация</label>
                    <textarea asp-for="Biography" class="form-control shadow-sm" rows="5"></textarea>
                    <span asp-validation-for="Biography" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between border-top pt-3">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left"></i> Назад към списъка
                    </a>
                    <button type="submit" class="btn btn-success px-5 shadow">
                        <i class="fas fa-save"></i> Запази промените
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
