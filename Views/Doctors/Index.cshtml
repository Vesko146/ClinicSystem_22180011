@model IEnumerable<ClinicSystem_22180011.Models.Doctor>

<div class="container mt-4">
    <div class="row text-center mb-4">
        <h2 class="fw-bold text-primary">Нашите Специалисти</h2>
        <p class="text-muted">Изберете лекар за вашия преглед</p>
    </div>

    @if (User.IsInRole("Admin"))
    {
        <div class="text-center mb-4">
            <a asp-controller="Doctors" asp-action="Create" class="btn btn-success px-4 py-2 rounded-3 fw-bold shadow-sm">
                <i class="bi bi-plus-circle me-2"></i>Добави Нов Лекар
            </a>
        </div>
    }
   
    <form asp-action="Index" method="get" class="mb-4">
        <div class="input-group shadow-sm max-width-600 mx-auto" style="max-width: 500px;">
            <input type="text" name="searchString" class="form-control border-end-0 p-3" placeholder="Търси лекар по име или специалност..." />
            <button type="submit" class="btn btn-primary px-4">
                Търси
            </button>
        </div>
    </form>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 hover-card-effect">
                    <div class="card-body p-4 text-center">

                        <div class="d-inline-block rounded-circle p-3 mb-3" style="background-color: #eef4ff; color: #0d6efd; width: 80px; height: 80px; display: inline-flex; align-items: center; justify-content: center;">
                            <i class="bi bi-person-badge fs-1"></i>
                        </div>

                        <h4 class="card-title fw-bold text-dark mb-1">@item.FullName</h4>
                        <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill mb-3 border border-primary-subtle">
                            @item.Specialty
                        </span>
                        <hr class="opacity-25">
                        <p class="card-text text-muted small text-start mb-2">
                            <strong>График:</strong> @item.ScheduleGroup
                        </p>
                        <p class="card-text text-muted small text-start text-truncate-3">
                            <strong>Биография:</strong> @item.Biography
                        </p>
                    </div>

                    <div class="card-footer bg-transparent border-0 p-4 pt-0">
                        <div class="d-flex gap-2">
                            <a asp-controller="Doctors" asp-action="Details" asp-route-id="@item.DoctorId" class="btn btn-outline-primary w-50 py-2 rounded-3 fw-bold">
                                Детайли
                            </a>

                            <a asp-controller="Appointments" asp-action="AvailableSlots" asp-route-doctorId="@item.DoctorId" class="btn btn-primary w-50 py-2 rounded-3 fw-bold shadow-sm">
                                Час
                            </a>
                        </div>
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Delete" asp-route-id="@item.DoctorId" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i> Изтрий
                            </a>
                        }
                    </div>

                </div>
            </div>
        }
    </div>
</div>

<style>
    .hover-card-effect {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .hover-card-effect:hover {
            transform: translateY(-5px);
            box-shadow: 0 1rem 2rem rgba(0,0,0,0.1) !important;
        }

    .text-truncate-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>