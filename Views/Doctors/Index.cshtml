@model IEnumerable<ClinicSystem_22180011.Models.Doctor>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-primary">Добави нов лекар</a>
    }
</p>
<form asp-action="Index" method="get">
    <div class="form-actions no-color">
        <p>
            Намери по име: <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" />
            <input type="submit" value="Търси" class="btn btn-primary" /> |
            <a asp-action="Index">Обратно към пълния списък</a>
        </p>
    </div>
</form>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FullName)
            </th>
            
            <th>
                @Html.DisplayNameFor(model => model.LastModified22180011)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.FullName)</td>
                <td>@Html.DisplayFor(modelItem => item.LastModified22180011)</td>
                <td>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.DoctorId" class="btn btn-sm btn-warning">Редактирай</a>
                        <a asp-action="Delete" asp-route-id="@item.DoctorId" class="btn btn-sm btn-danger">Изтрий</a>
                    }

                    <a asp-action="Details" asp-route-id="@item.DoctorId" class="btn btn-sm btn-info">Детайли</a>

                    @if (User.IsInRole("Patient"))
                    {
                        <a asp-controller="Appointments" asp-action="AvailableSlots" asp-route-doctorId="@item.DoctorId" class="btn btn-sm btn-success">Запиши час</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
