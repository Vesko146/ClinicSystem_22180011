@model IEnumerable<ClinicSystem_22180011.Models.Patient>

@{
    ViewData["Title"] = "Списък Пациенти";
}

<h1>Пациенти</h1>

<p>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-primary">Добави нов пациент</a>
    }
</p>

<form asp-action="Index" method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="searchString" class="form-control" 
               placeholder="Търси по име или фамилия..." value="@ViewData["CurrentFilter"]" />
        <button type="submit" class="btn btn-outline-primary">Търси</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Изчисти</a>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.FirstName)</th>
            <th>@Html.DisplayNameFor(model => model.LastName)</th>
            <th>@Html.DisplayNameFor(model => model.Phone)</th>
            <th>@Html.DisplayNameFor(model => model.LastModified22180011)</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.FirstName)</td>
            <td>@Html.DisplayFor(modelItem => item.LastName)</td>
            <td>@Html.DisplayFor(modelItem => item.Phone)</td>
            <td>@item.LastModified22180011.ToString("dd.MM.yyyy HH:mm")</td>
            <td>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Edit" asp-route-id="@item.PatientId">Edit</a> @:|
                    <a asp-action="Delete" asp-route-id="@item.PatientId">Delete</a> @:|
                }
                <a asp-action="Details" asp-route-id="@item.PatientId">Details</a>
            </td>
        </tr>
}
    </tbody>
</table>