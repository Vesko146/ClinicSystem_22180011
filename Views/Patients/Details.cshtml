@model ClinicSystem_22180011.Models.Patient

@{
    ViewData["Title"] = "Профил на пациент";
}

<div class="container mt-4">
    <div class="mb-3">
        <a asp-action="Index" class="btn btn-link text-decoration-none p-0 text-muted">
            <i class="bi bi-arrow-left"></i> Обратно към списъка
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

                <div class="bg-primary p-4 text-white text-center text-sm-start d-sm-flex align-items-center justify-content-between gap-4">
                    <div class="d-sm-flex align-items-center gap-4">
                        <div class="bg-white text-primary rounded-circle d-inline-flex align-items-center justify-content-center shadow" style="width: 70px; height: 70px; min-width: 70px;">
                            <i class="bi bi-person-vcard fs-2"></i>
                        </div>
                        <div class="mt-3 mt-sm-0">
                            <h2 class="fw-bold mb-1">@Model.FirstName @Model.LastName</h2>
                            <span class="badge bg-white text-primary rounded-pill fw-bold px-3 py-2">Пациент в системата</span>
                        </div>
                    </div>

                    <div class="mt-3 mt-sm-0 text-sm-end me-sm-2">
                        <div class="bg-white text-dark rounded-3 p-2 px-3 shadow-sm d-inline-block text-center">
                            <small class="text-muted d-block fw-bold text-uppercase" style="font-size: 0.65rem; letter-spacing: 0.5px; line-height: 1.2;">Общо прегледи</small>
                            <span class="fs-3 fw-bold text-primary" style="line-height: 1;">
                                @Model.Appointments.Where(a => a.AppointmentDate < DateTime.Now && a.Status != "Cancelled").Count()
                            </span>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4 bg-white">
                    <h5 class="card-title fw-bold text-dark mb-4 pb-2 border-bottom">Лична информация</h5>

                    <div class="row g-4">
                        <div class="col-sm-6">
                            <div class="d-flex align-items-center gap-3">
                                <div class="p-2 bg-light rounded-3 text-primary">
                                    <i class="bi bi-person-fill fs-4"></i>
                                </div>
                                <div>
                                    <small class="text-muted d-block uppercase fw-bold" style="font-size: 0.75rem; letter-spacing: 0.5px;">ИМЕ</small>
                                    <span class="text-dark fw-semibold fs-5">@Model.FirstName</span>
                                </div>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="d-flex align-items-center gap-3">
                                <div class="p-2 bg-light rounded-3 text-primary">
                                    <i class="bi bi-person-fill fs-4"></i>
                                </div>
                                <div>
                                    <small class="text-muted d-block uppercase fw-bold" style="font-size: 0.75rem; letter-spacing: 0.5px;">ФАМИЛИЯ</small>
                                    <span class="text-dark fw-semibold fs-5">@Model.LastName</span>
                                </div>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="d-flex align-items-center gap-3">
                                <div class="p-2 rounded-3 text-info" style="background-color: #f0fbfc;">
                                    <i class="bi bi-card-text fs-4"></i>
                                </div>
                                <div>
                                    <small class="text-muted d-block uppercase fw-bold" style="font-size: 0.75rem; letter-spacing: 0.5px;">ЕГН</small>
                                    <span class="text-dark fw-bold fs-5 tracking-wide">@Model.EGN</span>
                                </div>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="d-flex align-items-center gap-3">
                                <div class="p-2 bg-light rounded-3 text-success">
                                    <i class="bi bi-telephone-fill fs-4"></i>
                                </div>
                                <div>
                                    <small class="text-muted d-block uppercase fw-bold" style="font-size: 0.75rem; letter-spacing: 0.5px;">ТЕЛЕФОНЕН НОМЕР</small>
                                    <span class="text-dark fw-semibold fs-5">@(string.IsNullOrEmpty(Model.Phone) ? "Не е въведен" : Model.Phone)</span>
                                </div>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="d-flex align-items-center gap-3">
                                <div class="p-2 bg-light rounded-3 text-danger">
                                    <i class="bi bi-envelope-fill fs-4"></i>
                                </div>
                                <div>
                                    <small class="text-muted d-block uppercase fw-bold" style="font-size: 0.75rem; letter-spacing: 0.5px;">EMAIL</small>
                                    <span class="text-dark fw-semibold fs-5">@(string.IsNullOrEmpty(Model.Email) ? "Не е въведен" : Model.Email)</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div> 

            </div>
        </div>
    </div>
</div>