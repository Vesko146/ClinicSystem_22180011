@model ClinicSystem_22180011.Models.Appointment

@{
    ViewData["Title"] = "Детайли за прегледа";
}

<h1>Детайли</h1>

<div>
    <h4>Преглед</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Дата и час</dt>
        <dd class="col-sm-9">
            @Model.AppointmentDate.ToString("dd.MM.yyyy HH:mm")
        </dd>

        <dt class="col-sm-3">Статус</dt>
        <dd class="col-sm-9">
            @if (Model.Status == "Cancelled")
            {
                <span class="text-danger">Отказан</span>
            }
            else if (Model.AppointmentDate < DateTime.Now)
            {
                <span>Приключил</span>
            }
            else
            {
                <span class="text-success">Предстоящ</span>
            }
        </dd>

        <dt class="col-sm-3">Лекар</dt>
        <dd class="col-sm-9">
            @(Model.Doctor?.FullName ?? "Няма информация")
        </dd>

        <dt class="col-sm-3">Пациент</dt>
        <dd class="col-sm-9">
            @(Model.Patient != null ? $"{Model.Patient.FirstName} {Model.Patient.LastName}" : "Няма информация")
        </dd>

        <dt class="col-sm-3">@nameof(Model.LastModified22180011)</dt>
        <dd class="col-sm-9">@Model.LastModified22180011.ToString("dd.MM.yyyy HH:mm")</dd>
    </dl>
</div>

@if (Model.ExamDetails != null && Model.ExamDetails.Any())
{
    <div class="mt-4 p-3 border rounded bg-light">
        <h4 class="text-primary"><i class="bi bi-file-earmark-medical"></i> Медицинско заключение</h4>
        <hr />
        @foreach (var detail in Model.ExamDetails)
        {
            <div class="mb-3">
                <h5><strong>Диагноза:</strong></h5>
                <p class="lead">@detail.Diagnosis</p>
            </div>
            <div>
                <h5><strong>Рецепта / Предписание:</strong></h5>
                <p class="text-muted" style="white-space: pre-line;">@detail.Prescription</p>
            </div>
            <small class="text-muted">Записано на: @detail.LastModified22180011?.ToString("dd.MM.yyyy HH:mm")</small>
        }
    </div>
}
else if (Model.AppointmentDate < DateTime.Now && Model.Status != "Cancelled")
{
    <div class="alert alert-warning mt-3">
        Все още няма въведени медицински детайли за този приключил преглед.
    </div>
}

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">Назад към списъка</a>
</div>