@model ClinicSystem_22180011.Models.Appointment

@{
    ViewData["Title"] = "Детайли за прегледа";
}

<h1>Детайли</h1>

<div>
    <h4>Преглед</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Дата и час</dt>
        <dd class="col-sm-9">
            @Model.AppointmentDate.ToString("dd.MM.yyyy HH:mm")
        </dd>

        <dt class="col-sm-3">Статус</dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Status)
        </dd>

        <dt class="col-sm-3">Лекар</dt>
        <dd class="col-sm-9">
            @(Model.Doctor?.FullName ?? "Няма информация")
        </dd>

        <dt class="col-sm-3">Пациент</dt>
        <dd class="col-sm-9">
            @(Model.Patient != null ? $"{Model.Patient.FirstName} {Model.Patient.LastName}" : "Няма информация")
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Index" class="btn btn-secondary">Назад към списъка</a>
</div>