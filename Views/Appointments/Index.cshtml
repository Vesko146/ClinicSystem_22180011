@model IEnumerable<ClinicSystem_22180011.Models.Appointment>

@{
    ViewData["Title"] = "Моите Прегледи";
}

<h1>Списък с прегледи</h1>

<p>
    <a asp-controller="Patients" asp-action="ChooseDoctor" class="btn btn-primary">Запиши нов час</a>
</p>

<table class="table table-hover">
    <thead>
        <tr>
            <th>Дата и час</th>
            <th>Статус</th>
            <th>Лекар</th>
            <th>Пациент</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            // Проверка дали часът е минал за по-блед цвят на реда
            string rowClass = item.AppointmentDate < DateTime.Now ? "table-light text-muted" : "";

            <tr class="@rowClass">
                <td>
                    <strong>@item.AppointmentDate.ToString("dd.MM.yyyy HH:mm")</strong>
                </td>
                <td>
                    @if (item.AppointmentDate < DateTime.Now)
                    {
                        <span class="badge bg-secondary">Приключил</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Предстоящ</span>
                    }
                </td>
                <td>
                    @item.Doctor.FullName @* Показваме името, не ID-то *@
                </td>
                <td>
                    @item.Patient.FirstName @item.Patient.LastName @* Име на пациента *@
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.AppointmentId" class="btn btn-sm btn-info">Детайли</a>
                    @if (User.IsInRole("Admin") || item.AppointmentDate > DateTime.Now)
                    {
                        <span> | </span>
                        <a asp-action="Delete" asp-route-id="@item.AppointmentId" class="btn btn-sm btn-danger">Откажи</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>