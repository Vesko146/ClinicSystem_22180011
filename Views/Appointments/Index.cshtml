@model IEnumerable<ClinicSystem_22180011.Models.Appointment>

@{
    ViewData["Title"] = "Моите Прегледи";
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Грешка!</strong> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>Успех!</strong> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<h1>Списък с прегледи</h1>

<p>
    <a asp-controller="Patients" asp-action="ChooseDoctor" class="btn btn-primary">Запиши нов час</a>
</p>

<table class="table table-hover">
    <thead>
        <tr>
            <th>Дата и час</th>
            <th>Статус</th>
            <th>Лекар</th>
            <th>Пациент</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            string rowClass = item.AppointmentDate < DateTime.Now ? "table-light text-muted" : "";

            <tr class="@rowClass">
                <td>
                    <strong>@item.AppointmentDate.ToString("dd.MM.yyyy HH:mm")</strong>
                </td>
                <td>
                    @if (item.AppointmentDate < DateTime.Now)
                    {
                        <span class="badge bg-secondary">Приключил</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Предстоящ</span>
                    }
                </td>
                <td>
                    @(item.Doctor?.FullName ?? "Няма информация")
                </td>
                <td>
                    @(item.Patient != null ? $"{item.Patient.FirstName} {item.Patient.LastName}" : "Няма информация")
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.AppointId" class="btn btn-sm btn-info">Детайли</a>

                    @if ((User.IsInRole("Patient") || User.IsInRole("Admin")) && item.AppointmentDate > DateTime.Now)
                    {
                        <span> | </span>
                        <a asp-action="Delete" asp-route-id="@item.AppointId" class="btn btn-sm btn-danger">Откажи</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>