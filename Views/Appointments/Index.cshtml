@model IEnumerable<ClinicSystem_22180011.Models.Appointment>

@{
    ViewData["Title"] = "Моите Прегледи";
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Грешка!</strong> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>Успех!</strong> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<h1>Списък с прегледи</h1>

<p>
    @if (User.IsInRole("Patient")){
    <a asp-action="ChooseDoctor" asp-controller="Patients" class="btn btn-primary">Запиши нов час</a>
    }
    @if (User.IsInRole("Admin") || User.IsInRole("Doctor"))
    {
        <a asp-action="ExportToCSV" class="btn btn-outline-success">Експорт в Excel (CSV)</a>
    }
</p>

<form asp-action="Index" method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="searchString" class="form-control"
               placeholder="Търси по име на лекар или пациент..." value="@ViewData["CurrentFilter"]" />
        <button type="submit" class="btn btn-primary">Търси</button>
        <a asp-action="Index" class="btn btn-secondary">Изчисти</a>
    </div>
</form>

<table class="table table-hover">
    <thead>
        <tr>
            <th>Дата и час</th>
            <th>Статус</th>
            <th>Лекар</th>
            <th>Пациент</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            string rowClass = item.AppointmentDate < DateTime.Now ? "table-light text-muted" : "";

            <tr class="@rowClass">
                <td>
                    <strong>@item.AppointmentDate.ToString("dd.MM.yyyy HH:mm")</strong>
                </td>
                <td>
                    @if (item.Status == "Cancelled")
                    {
                        <span class="badge bg-secondary">Отказан</span>
                    }
                    else if (item.AppointmentDate < DateTime.Now)
                    {
                        <span class="badge bg-light text-dark border">Приключил</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Предстоящ</span>
                    }
                </td>

                <td>
                    @(item.Doctor?.FullName ?? "Няма информация")
                </td>
                <td>
                    @(item.Patient != null ? $"{item.Patient.FirstName} {item.Patient.LastName}" : "Няма информация")
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.AppointId" class="btn btn-sm btn-info text-white">Детайли</a>

                    @if (item.Status != "Cancelled" && item.AppointmentDate > DateTime.Now)
                    {
                        @if (User.IsInRole("Patient") || User.IsInRole("Admin"))
                        {
                            <span> | </span>
                            <form asp-action="Cancel" asp-route-id="@item.AppointId" method="post" style="display:inline;">
                                <button type="submit" class="btn btn-sm btn-danger"
                                        onclick="return confirm('Сигурни ли сте, че искате да откажете този час?')">
                                    Откажи
                                </button>
                            </form>
                        }
                    }
                </td>
            </tr>
        }
    </tbody>
</table>