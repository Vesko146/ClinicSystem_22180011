@model IEnumerable<ClinicSystem_22180011.Models.Appointment>

@{
    ViewData["Title"] = "Моите Прегледи";
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Грешка!</strong> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>Успех!</strong> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="mt-3 mb-4">
    <h1 class="h2 fw-bold text-dark mb-3">Списък с прегледи</h1>

    <div class="row g-2">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-warning text-dark p-2 text-center rounded-3">
                <small class="fw-bold text-uppercase opacity-75" style="font-size: 0.75rem;">Предстоящи</small>
                <span class="fs-4 fw-bold">@ViewBag.UpcomingCount</span>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-success text-white p-2 text-center rounded-3">
                <small class="fw-bold text-uppercase opacity-75" style="font-size: 0.75rem;">Приключили</small>
                <span class="fs-4 fw-bold">@ViewBag.CompletedCount</span>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-danger text-white p-2 text-center rounded-3">
                <small class="fw-bold text-uppercase opacity-75" style="font-size: 0.75rem;">Отказани</small>
                <span class="fs-4 fw-bold">@ViewBag.CancelledCount</span>
            </div>
        </div>
    </div>
</div>

<p>
    @if (User.IsInRole("Patient"))
    {
        <a asp-controller="Doctors" asp-action="Index" class="btn btn-primary mb-2">
            <i class="fas fa-plus"></i> Запиши нов час
        </a>
    }
    @if (User.IsInRole("Admin") || User.IsInRole("Doctor"))
    {
        <a asp-action="ExportToCSV"
           asp-route-searchDoctor="@ViewData["CurrentDoctor"]"
           asp-route-searchPatient="@ViewData["CurrentPatient"]"
           asp-route-fromDate="@ViewData["CurrentFromDate"]"
           asp-route-toDate="@ViewData["CurrentToDate"]"
           asp-route-sortOrder="@ViewData["CurrentSort"]"
           asp-route-class="btn btn-outline-success mb-2">Експорт в Excel (CSV)</a>
    }
</p>

<div class="card border-0 shadow-sm rounded-3 mb-4 bg-light">
    <div class="card-body p-3">
        <form asp-action="Index" method="get">
            <div class="row g-2">
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted mb-1">Лекар</label>
                    <input type="text" name="searchDoctor" value="@ViewData["CurrentDoctor"]" class="form-control" placeholder="Име на лекар..." />
                </div>

                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted mb-1">Пациент</label>
                    <input type="text" name="searchPatient" value="@ViewData["CurrentPatient"]" class="form-control" placeholder="Име на пациент..." />
                </div>

                <div class="col-md-2">
                    <label class="form-label small fw-bold text-muted mb-1">От дата</label>
                    <input type="date" name="fromDate" value="@ViewData["CurrentFromDate"]" class="form-control" />
                </div>

                <div class="col-md-2">
                    <label class="form-label small fw-bold text-muted mb-1">До дата</label>
                    <input type="date" name="toDate" value="@ViewData["CurrentToDate"]" class="form-control" />
                </div>

                <div class="col-md-2 d-flex align-items-end gap-1">
                    <button type="submit" class="btn btn-primary w-100 fw-bold">Търси</button>
                    <a asp-action="Index" class="btn btn-secondary" title="Изчисти филтрите">X</a>
                </div>
            </div>
        </form>
    </div>
</div>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>
                <a asp-action="Index"
                   asp-route-sortOrder="@ViewData["DateSortParm"]"
                   asp-route-searchDoctor="@ViewData["CurrentDoctor"]"
                   asp-route-searchPatient="@ViewData["CurrentPatient"]"
                   asp-route-fromDate="@ViewData["CurrentFromDate"]"
                   asp-route-toDate="@ViewData["CurrentToDate"]">Дата и час</a>
            </th>
            <th>Статус</th>
            <th>LastModified22180011</th>
            <th>
                <a asp-action="Index"
                   asp-route-sortOrder="@ViewData["NameSortParm"]"
                   asp-route-searchDoctor="@ViewData["CurrentDoctor"]"
                   asp-route-searchPatient="@ViewData["CurrentPatient"]"
                   asp-route-fromDate="@ViewData["CurrentFromDate"]"
                   asp-route-toDate="@ViewData["CurrentToDate"]">Лекар</a>
            </th>
            <th>Пациент</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            string rowClass = item.AppointmentDate < DateTime.Now ? "table-light text-muted" : "";

            <tr class="@rowClass">
                <td>
                    <strong>@item.AppointmentDate.ToString("dd.MM.yyyy HH:mm")</strong>
                </td>
                <td>
                    @if (item.Status == "Cancelled")
                    {
                        <span class="badge bg-danger px-3 py-2 text-white rounded-pill shadow-sm">
                            Отказан
                        </span>
                    }
                    else if (item.AppointmentDate < DateTime.Now)
                    {
                        <span class="badge bg-success px-3 py-2 text-white rounded-pill shadow-sm">
                            Приключил
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill shadow-sm">
                            Предстоящ
                        </span>
                    }
                </td>
                <td>@item.LastModified22180011.ToString("dd.MM.yyyy HH:mm")</td>
                <td>
                    @(item.Doctor?.FullName ?? "Няма информация")
                </td>
                <td>
                    @(item.Patient != null ? $"{item.Patient.FirstName} {item.Patient.LastName}" : "Няма информация")
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.AppointId" class="btn btn-sm btn-info text-white">Детайли</a>

                    @if (User.IsInRole("Doctor") && item.AppointmentDate < DateTime.Now && item.Status != "Cancelled")
                    {
                        <span> | </span>
                        <a asp-controller="ExamDetails" asp-action="Create" asp-route-appointId="@item.AppointId"
                           class="btn btn-sm btn-success">Добави медицински данни</a>
                    }

                    @if (item.Status != "Cancelled" && item.AppointmentDate > DateTime.Now)
                    {
                        @if (User.IsInRole("Patient") || User.IsInRole("Admin"))
                        {
                            <span> | </span>
                            <form asp-action="Cancel" asp-route-id="@item.AppointId" method="post" style="display:inline;">
                                <button type="submit" class="btn btn-sm btn-danger"
                                        onclick="return confirm('Сигурни ли сте, че искате да откажете този час?')">
                                    Откажи
                                </button>
                            </form>
                        }
                    }
                </td>
            </tr>
        }
    </tbody>
</table>