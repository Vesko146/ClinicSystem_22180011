@model IEnumerable<DateTime>
@{
    ViewData["Title"] = "Свободни часове";
    var takenSlots = ViewBag.TakenSlots as List<DateTime>;
}

<h2 class="fw-bold text-dark mb-1">Свободни часове за @ViewBag.DoctorName</h2>
<p class="text-muted">Текущо избрана дата: <strong class="text-primary">@ViewBag.SelectedDate.ToShortDateString()</strong></p>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card card-body border-0 shadow-sm bg-light h-100 justify-content-center">
            <label class="form-label fw-semibold text-secondary">Изберете друга дата:</label>
            <form asp-action="AvailableSlots" method="get">
                <input type="hidden" name="doctorId" value="@ViewBag.DoctorId" />
                <input type="date" name="date" class="form-control border-secondary-subtle mb-2"
                       value="@(((DateTime)ViewBag.SelectedDate).ToString("yyyy-MM-dd"))"
                       min="@DateTime.Today.ToString("yyyy-MM-dd")"
                       max="@DateTime.Today.AddDays(14).ToString("yyyy-MM-dd")"
                       onchange="this.form.submit()" />
                <small class="text-muted d-block" style="font-size: 0.8rem;">Графикът е достъпен за 2 седмици напред.</small>
            </form>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card card-body border-0 shadow-sm bg-white h-100 justify-content-center border-start border-primary border-4">
            <h6 class="fw-bold text-primary mb-3"><i class="bi bi-sliders me-2"></i>Параметри на часа</h6>

            <div class="mb-2">
                <label class="form-label small fw-medium text-muted mb-1">Тип финансиране:</label>
                <select id="mainFundingType" class="form-select form-select-sm">
                    <option value="НЗОК">По Здравна каса (НЗОК)</option>
                    <option value="Платен">Платен прием (Частно)</option>
                </select>
            </div>

            <div>
                <label class="form-label small fw-medium text-muted mb-1">Вид на прегледа:</label>
                <select id="mainVisitType" class="form-select form-select-sm">
                    <option value="Първичен преглед">Първичен преглед (30 мин.)</option>
                    <option value="Вторичен преглед">Вторичен преглед (15 мин.)</option>
                    <option value="Медицинска манипулация">Медицинска манипулация (20 мин.)</option>
                </select>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card card-body border-0 shadow-sm bg-white h-100 justify-content-center border-start border-success border-4">
            <h6 class="fw-bold text-success mb-2"><i class="bi bi-cash-coin me-2"></i>Ценоразпис (Платен)</h6>
            <table class="table table-sm table-borderless align-middle mb-0" style="font-size: 0.85rem;">
                <tbody>
                    <tr class="border-bottom">
                        <td class="py-1 text-muted">Първичен преглед</td>
                        <td class="text-end py-1 fw-bold text-success">60.00 лв.</td>
                    </tr>
                    <tr class="border-bottom">
                        <td class="py-1 text-muted">Вторичен преглед</td>
                        <td class="text-end py-1 fw-bold text-success">35.00 лв.</td>
                    </tr>
                    <tr>
                        <td class="py-1 text-muted">Манипулация</td>
                        <td class="text-end py-1 fw-bold text-success">45.00 лв.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<hr />

@if (ViewBag.IsWorkingDay == false)
{
    <div class="alert alert-warning text-center mt-4 border-0 shadow-sm rounded-3">
        <h4>Лекарят не работи на тази дата (@ViewBag.SelectedDate.ToShortDateString()).</h4>
        <p class="mb-0">Моля, изберете друг ден от календара по-горе.</p>
    </div>
}
else
{
    <div class="row">
        @foreach (var slot in Model)
        {
            bool isTaken = takenSlots != null && takenSlots.Any(ts => ts == slot);

            <div class="col-md-2 mb-3">
                @if (isTaken)
                {
                    <button class="btn btn-secondary w-100 py-2.5 shadow-sm" disabled>
                        <strong>@slot.ToString("HH:mm")</strong> <br /> <small style="font-size: 0.75rem;">(Зает)</small>
                    </button>
                }
                else
                {
                    <form asp-action="Book" method="post" class="booking-form">
                        <input type="hidden" name="doctorId" value="@ViewBag.DoctorId" />
                        <input type="hidden" name="slot" value="@slot.ToString("yyyy-MM-dd HH:mm")" />

                        <input type="hidden" name="fundingType" class="hidden-funding" value="НЗОК" />
                        <input type="hidden" name="visitType" class="hidden-visit" value="Първичен преглед" />

                        <button type="submit" class="btn btn-outline-primary w-100 py-3 fw-bold shadow-sm">
                            @slot.ToString("HH:mm")
                        </button>
                    </form>
                }
            </div>
        }
    </div>
}

<div class="mt-3">
    <a asp-controller="Patients" asp-action="ChooseDoctor" class="btn btn-outline-secondary px-4">
        <i class="bi bi-arrow-left me-1"></i> Назад към избор на лекар
    </a>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var pastCount = @(ViewBag.PastAppointmentsCount ?? 0);
            var visitSelect = document.getElementById("mainVisitType");

            if (visitSelect) {
                if (pastCount === 0) {
                    for (var i = visitSelect.options.length - 1; i >= 0; i--) {
                        if (visitSelect.options[i].value !== "Първичен преглед") {
                            visitSelect.remove(i);
                        }
                    }
                } else {
                    for (var i = 0; i < visitSelect.options.length; i++) {
                        if (visitSelect.options[i].value === "Първичен преглед") {
                            visitSelect.remove(i);
                            break;
                        }
                    }
                }
            }

            var mainFunding = document.getElementById("mainFundingType");
            var mainVisit = document.getElementById("mainVisitType");

            function syncOptionsToButtons() {
                document.querySelectorAll('.hidden-funding').forEach(el => el.value = mainFunding.value);
                document.querySelectorAll('.hidden-visit').forEach(el => el.value = mainVisit.value);
            }

            mainFunding.addEventListener("change", syncOptionsToButtons);
            mainVisit.addEventListener("change", syncOptionsToButtons);

            syncOptionsToButtons();
        });
    </script>
}