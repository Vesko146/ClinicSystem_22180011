@page
@model RegisterModel
@{
    ViewData["Title"] = "Регистрация";
}

<div class="container">
    <div class="row justify-content-center align-items-center mt-5 mb-5">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 p-4">
                <div class="card-body">

                    <div class="text-center mb-4">
                        <div class="text-primary mb-2 d-inline-block rounded-circle p-3" style="background-color: #eef4ff; color: #0d6efd;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" class="bi bi-person-plus-fill" viewBox="0 0 16 16">
                                <path d="M1 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1H1zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6z" />
                                <path fill-rule="evenodd" d="M13.5 5a.5.5 0 0 1 .5.5V7h1.5a.5.5 0 0 1 0 1H14v1.5a.5.5 0 0 1-1 0V8h-1.5a.5.5 0 0 1 0-1H13V5.5a.5.5 0 0 1 .5-.5z" />
                            </svg>
                        </div>
                        <h3 class="fw-bold text-dark mt-2">Нова Регистрация</h3>
                        <p class="text-muted small">Създайте профил на пациент в ClinicSystem</p>
                    </div>

                    <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.FirstName" class="form-control rounded-3" aria-required="true" placeholder="Име" />
                            <label asp-for="Input.FirstName">Име</label>
                            <span asp-validation-for="Input.FirstName" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.LastName" class="form-control rounded-3" aria-required="true" placeholder="Фамилия" />
                            <label asp-for="Input.LastName">Фамилия</label>
                            <span asp-validation-for="Input.LastName" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Phone" class="form-control rounded-3" maxlength="10" aria-required="true" placeholder="Телефон" />
                            <label asp-for="Input.Phone">Телефон (10 цифри)</label>
                            <span asp-validation-for="Input.Phone" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.EGN" class="form-control rounded-3" maxlength="10" aria-required="true" placeholder="ЕГН" />
                            <label asp-for="Input.EGN">ЕГН (10 цифри)</label>
                            <span asp-validation-for="Input.EGN" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email" class="form-control rounded-3" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                            <label asp-for="Input.Email">Имейл адрес</label>
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Password" class="form-control rounded-3" autocomplete="new-password" aria-required="true" placeholder="password" />
                            <label asp-for="Input.Password">Парола</label>
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-4">
                            <input asp-for="Input.ConfirmPassword" class="form-control rounded-3" autocomplete="new-password" aria-required="true" placeholder="password" />
                            <label asp-for="Input.ConfirmPassword">Потвърди парола</label>
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <button id="registerSubmit" type="submit" class="btn btn-primary w-100 py-3 rounded-3 fw-bold shadow">
                            Регистрирай се
                        </button>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}